# Production Environment Variables for Frontend
# These will be configured in Vercel Dashboard → Project → Settings → Environment Variables

# API Configuration
# Replace with your actual Render backend URL
VITE_API_URL=https://photo-memories-api.onrender.com/api

# IMPORTANT: Set to false to use real backend API
VITE_USE_MOCK_API=false

# App Configuration
VITE_APP_NAME=Photo Memories

# Optional: Analytics
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
# VITE_PLAUSIBLE_DOMAIN=photo-memories.com

# Optional: Error Tracking
# VITE_SENTRY_DSN=https://your-sentry-dsn

# Optional: Feature Flags
# VITE_ENABLE_PHOTO_UPLOAD=true
# VITE_ENABLE_SHARING=true
# VITE_ENABLE_AI_FEATURES=false
